<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="ni.edu.uam.caferteria.controller.CafeteriaController"
            prefHeight="550" prefWidth="850">

    <top>
        <Label text="Recepción de Lotes de Café" style="-fx-font-size: 20px; -fx-font-weight: bold;">
            <BorderPane.margin>
                <Insets top="10" left="10" bottom="10"/>
            </BorderPane.margin>
        </Label>
    </top>

    <!-- FORMULARIO DE INGRESO -->
    <left>
        <VBox spacing="10" prefWidth="250">
            <padding>
                <Insets top="10" left="10" right="10" bottom="10"/>
            </padding>

            <Label text="ID del Lote:" style="-fx-font-weight: bold;"/>
            <TextField fx:id="txtId" promptText="Ej. 1" />

            <Label text="Productor:" style="-fx-font-weight: bold;"/>
            <TextField fx:id="txtProductor" promptText="Nombre del productor" />

            <Label text="Fecha:" style="-fx-font-weight: bold;"/>
            <DatePicker fx:id="dpFecha" promptText="Seleccione la fecha" maxWidth="Infinity" />

            <Label text="Cantidad (Kg):" style="-fx-font-weight: bold;"/>
            <TextField fx:id="txtCantidad" promptText="Ej. 150.5" />

            <Label text="Calidad:" style="-fx-font-weight: bold;"/>
            <ComboBox fx:id="cbCalidad" promptText="Seleccione calidad" maxWidth="Infinity" />

            <Button text="Agregar Lote" onAction="#agregarLote" maxWidth="Infinity" style="-fx-margin-top: 15px;"/>
        </VBox>
    </left>

    <!-- TABLA DE DATOS -->
    <center>
        <TableView fx:id="tblLotes">
            <columns>
                <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
                <TableColumn fx:id="colProductor" text="Productor" prefWidth="150"/>
                <TableColumn fx:id="colFecha" text="Fecha" prefWidth="100"/>
                <TableColumn fx:id="colCantidad" text="Cantidad (Kg)" prefWidth="120"/>
                <TableColumn fx:id="colCalidad" text="Calidad" prefWidth="100"/>
            </columns>
        </TableView>
    </center>

    <bottom>
        <VBox spacing="5">
            <padding>
                <Insets top="10" left="10" right="10" bottom="10"/>
            </padding>
            <Label text="Detalle del lote seleccionado:" style="-fx-font-weight: bold;"/>
            <Label fx:id="lblDetalle" text="Haz clic en un lote para ver sus detalles"/>
        </VBox>
    </bottom>

</BorderPane>